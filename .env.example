# Message Control MS Environment Variables
# Copy this file to .env and fill in the values

# Service Configuration
MESSAGE_CONTROL_PORT=3007
MESSAGE_CONTROL_HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://nota_zip:YOUR_PASSWORD@postgres:5432/nota_zip

# RabbitMQ
RABBITMQ_URL=amqp://nota_zip:YOUR_PASSWORD@rabbitmq:5672/nota_zip

# Microservices URLs
WHATSAPP_API_URL=http://whatsapp-adp:3006
AUTH_MS_URL=http://auth-ms:3004
USER_MS_URL=http://user-ms:3002

# Node Environment
NODE_ENV=production
