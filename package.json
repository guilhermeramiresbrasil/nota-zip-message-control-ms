    "amqplib": "^2.0.1",
    "axios": "^1.6.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.0.0",
    "ioredis": "^5.3.2",
    "pg": "^8.21.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^9.0.0",
    "bun-types": "latest"
